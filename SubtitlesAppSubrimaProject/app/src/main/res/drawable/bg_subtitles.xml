<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Smooth diagonal gradient from teal to light cyan -->
    <gradient
        android:startColor="#2193B0"
        android:endColor="#6DDBED"
        android:angle="135" />

    <!-- Optional slight corner radius for softness -->
    <corners android:radius="0dp" />

    <!-- Optional padding inside if needed -->
    <padding
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp" />
</shape>
