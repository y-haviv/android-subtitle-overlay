<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        ************************************
        Switch Container (Rounded Background)
        ************************************
        LinearLayout that wraps the toggle switch and drag handle
        - ID: switchContainer
        - Orientation: horizontal
        - LayoutDirection: RTL for proper drag handle placement
        - Background: rounded_switch_background drawable
        - Gravity: center_vertical to align switch and handle
        - Padding: 8dp horizontal & vertical
        - Positioned at the top-right of parent with 24dp top margin
    -->
    <LinearLayout
        android:id="@+id/switchContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:background="@drawable/rounded_switch_background"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="0dp">

        <!--
            ************************************
            Drag Handle Container (Vertical Lines)
            ************************************
            LinearLayout representing the draggable visual handle
            - ID: dragHandle
            - Size: 20dp width, 60dp height
            - Orientation: vertical
            - Gravity: center to align bars
            - Background: transparent
            - MarginStart: 8dp for spacing from edge
        -->
        <LinearLayout
            android:id="@+id/dragHandle"
            android:layout_width="20dp"
            android:layout_height="60dp"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent">

            <!--
                ************************************
                Drag Bar 1
                ************************************
                Thin horizontal line to indicate drag handle
                - Width: 14dp, Height: 2dp
                - Vertical margin: 2dp
                - Color: #666666 (dark gray)
            -->
            <View
                android:layout_width="14dp"
                android:layout_height="2dp"
                android:layout_marginVertical="2dp"
                android:background="#666666" />

            <!--
                ************************************
                Drag Bar 2
                ************************************
                Same as above
            -->
            <View
                android:layout_width="14dp"
                android:layout_height="2dp"
                android:layout_marginVertical="2dp"
                android:background="#666666" />

            <!--
                ************************************
                Drag Bar 3
                ************************************
                Same as above
            -->
            <View
                android:layout_width="14dp"
                android:layout_height="2dp"
                android:layout_marginVertical="2dp"
                android:background="#666666" />
        </LinearLayout>

        <!--
            ************************************
            Toggle Switch
            ************************************
            SwitchCompat component for enabling/disabling a feature
            - ID: toggleSwitch
            - Width/Height: wrap_content
            - No text displayed (showText="false", text="")
            - Text size: 16sp (for accessibility if needed)
        -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/toggleSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:showText="false"
            android:text=""
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
