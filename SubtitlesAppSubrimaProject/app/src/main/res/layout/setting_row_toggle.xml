<?xml version="1.0" encoding="utf-8"?>
<!--
    ********************************************************************
    Settings Row with Toggle Switch Layout
    ********************************************************************
    Root Layout: LinearLayout
    - Orientation: horizontal
    - Gravity: center (vertically aligns child views)
    - Width: match_parent, Height: 56dp
    - Padding: horizontal 8dp
    - Purpose: used as a single row in the settings screen for enabling/disabling features
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <!--
        ********************************************************************
        Label TextView
        ********************************************************************
        Displays the descriptive label for the toggle switch
        - ID: tvLabel
        - Width/Height: wrap_content
        - Text: placeholder string resource (label_place_hold)
        - Text color: white
        - Text size: 16sp
        - MarginEnd: 12dp to separate from the Switch
        - Purpose: provides context to the toggle switch functionality
    -->
    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_place_hold"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:layout_marginEnd="12dp" />

    <!--
        ********************************************************************
        Toggle Switch
        ********************************************************************
        Switch component to enable or disable a feature
        - ID: switchValue
        - Width/Height: wrap_content
        - Thumb tint: switch_thumb_color (custom color for the toggle knob)
        - Track tint: switch_track_color (custom color for the track background)
        - Purpose: allows the user to toggle a specific setting on/off
    -->
    <Switch
        android:id="@+id/switchValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:thumbTint="@color/switch_thumb_color"
        android:trackTint="@color/switch_track_color" />


    <!--
        ********************************************************************
        Help Button
        ********************************************************************
        Provides contextual help or additional information about the toggle
        - ID: btnHelp
        - Width/Height: 32dp
        - Padding: 4dp
        - Source drawable: ic_help
        - Background: ripple effect (selectableItemBackgroundBorderless)
        - Accessibility: contentDescription for screen readers
        - Purpose: optional help button to explain the toggle feature
    -->
    <ImageButton
        android:id="@+id/btnHelp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:src="@drawable/ic_help"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_help" />
</LinearLayout>
