<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <!--
        ************************************
        Subtitle TextView
        ************************************
        Displays the live overlay subtitles on screen.
        - ID: overlay_text
        - Width: match_parent, Height: wrap_content
        - Margins: 24dp start/end, 36dp bottom
        - Padding: 12dp inside the subtitle box
        - Background: subtitle_background drawable (custom rounded or shaded background)
        - Text color: white (#FFF)
        - Text size: 18sp, auto-scaling enabled
        - Max lines: 2, ellipsize at end for overflow
        - Line spacing: 2dp extra
        - Break strategy: simple (for consistent line breaks)
        - Hyphenation frequency: none (prevents word splitting)
        - Auto-size text: uniform scaling between 12sp and 24sp, step granularity 2sp
        - Text alignment and gravity:
            • Gravity: center_vertical
            • Text alignment: gravity
            • Text direction: inherit (follows system layout direction)
        - Font padding disabled for tighter text positioning (includeFontPadding="false")
        - Purpose: shows dynamic subtitles generated by the app on top of other UI or screen content
    -->
    <TextView
        android:id="@+id/overlay_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:padding="12dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:background="@drawable/subtitle_background"
        android:textColor="#FFF"
        android:textSize="18sp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeStepGranularity="2sp"

        android:gravity="center_vertical"
        android:textAlignment="gravity"
        android:textDirection="inherit"
        />

</FrameLayout>
